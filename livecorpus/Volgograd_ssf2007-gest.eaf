    <TIER ANNOTATOR="fizzygrapedrink" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@ssf2007f" PARTICIPANT="@ssf2007f" TIER_ID="gestComment@ssf2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1108" ANNOTATION_REF="a1029">
                <ANNOTATION_VALUE>под вопросом конечно...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1113" ANNOTATION_REF="a1030">
                <ANNOTATION_VALUE>надеюсь "насмешка" подходит, но она довольно light-hearted</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1041" ANNOTATION_REF="a1032">
                <ANNOTATION_VALUE>я не уверена, какой тут тип подходит больше всего, мне кажется, что этот жест похож на имитирование этих абстрактных людей, которые так говорят и так указывают, поэтому сначала я хотела разметить его как изобразительный, но НКРЯ говорит, что "пригрозить пальцем" -- это жест речевого действия</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1047" ANNOTATION_REF="a1034">
                <ANNOTATION_VALUE>разметила как "беспокойство", потому что мне кажется, что Софа в принципе переживала во время интервью &lt;/3</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1061" ANNOTATION_REF="a1058">
                <ANNOTATION_VALUE>сложно определиться, не уверена, насколько это действительно указательный жест</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1080" ANNOTATION_REF="a1077">
                <ANNOTATION_VALUE>сложно...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1088" ANNOTATION_REF="a1082">
                <ANNOTATION_VALUE> i am stumped, совсем не уверена, что здесь</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
